{
  "name": "Algori",
  "scopeName": "source.algori",
  "fileTypes": [
    "algori"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "match": "#.*$",
          "name": "comment.line.hash.algori"
        },
        {
          "match": "//.*$",
          "name": "comment.line.double-slash.algori"
        },
        {
          "begin": "/\\*",
          "end": "\\*/",
          "name": "comment.block.algori"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "match": "\\b(se|senao|enquanto|para|funcao|retorne|constante|pare|continua|programa|algori|tipo|procedimento)\\b",
          "name": "keyword.control.algori"
        },
        {
          "match": "\\b(mostrar|capturar|escreva|escrevaln|leia|ler)\\b",
          "name": "support.function.algori"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "match": "\\b(inteiro|texto|real|logico|caractere|decimal|vetor|matriz|vazio)\\b",
          "name": "storage.type.algori"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "match": "\\b(verdadeiro|falso)\\b",
          "name": "constant.language.algori"
        },
        {
          "match": "\\b(e|ou|nao|div|mod)\\b",
          "name": "constant.language.algori"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "begin": "\"",
          "end": "\"",
          "name": "string.quoted.double.algori"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "match": "\\b[0-9]+(\\.[0-9]+)?\\b",
          "name": "constant.numeric.algori"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
          "name": "entity.name.function.algori"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "match": "(\\+|\\-|\\*|/|=|==|!=|<=|>=|<|>)",
          "name": "keyword.operator.algori"
        }
      ]
    }
  }
}
